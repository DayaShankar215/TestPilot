# Base URL of the TestPilot API. The mock service intercepts requests when
# VITE_USE_MOCK_API is true, so this value is only used for real API calls.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Set to false (or remove) to send requests to a real API instead of the in-browser mock.
VITE_USE_MOCK_API=true