NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
DATABASE_URL="mysql://testpilot:testpilot@127.0.0.1:3306/testpilot"

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false

SESSION_COOKIE_NAME=testpilot_sid
CSRF_COOKIE_NAME=testpilot_csrf
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_TTL_HOURS=168
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_SUGGESTIONS=6
AI_PROMPT_VERSION=2026.03

AUTOMATION_ENABLED=false
AUTOMATION_MAX_CONCURRENCY=2
AUTOMATION_JOB_TIMEOUT_MS=120000
AUTOMATION_ALLOWED_HOSTS=localhost,127.0.0.1
ARTIFACT_DIR=var/artifacts

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=20