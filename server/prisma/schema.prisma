generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity: users, workspaces, sessions
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  title        String?
  timezone     String   @default("UTC")
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  createdProjects      Project[]         @relation("ProjectCreator")
  activityLogs         ActivityLog[]
  notifications        Notification[]

  preferences UserPreference?
  aiUsage     AiGeneration[]

  ownedWorkspaces     Workspace[]          @relation("WorkspaceOwner")
  createdProjects     Project[]            @relation("ProjectCreator")
  createdRequirements Requirement[]        @relation("RequirementCreator")
  ownedRequirements   Requirement[]        @relation("RequirementOwner")
  requirementVersions RequirementVersion[]
  createdTestCases    TestCase[]
  testCaseVersions    TestCaseVersion[]
  createdRuns         TestRun[]
  testResults         TestResult[]
  assignedDefects     Defect[]             @relation("DefectAssignee")
  reportedDefects     Defect[]             @relation("DefectReporter")
  defectComments      DefectComment[]
  defectHistory       DefectHistory[]
  createdPlans        RegressionPlan[]
  createdJobs         AutomationJob[]

  @@index([email])
  @@map("users")
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("system")
  timezone        String   @default("UTC")
  dateFormat      String   @default("dd MMM yyyy")
  weekStartsOn    String   @default("monday")
  compactTables   Boolean  @default(false)
  defaultPageSize Int      @default(25)
  notificationSettings Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  csrfToken String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        String   @default("business")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  projects  Project[]

  @@index([ownerId])
  @@map("workspaces")
}

enum WorkspaceRole {
  owner
  admin
  qa_lead
  tester
  viewer
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(tester)
  title       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  name        String
  description String?
  status      String    @default("planning")
  ownerId     String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?            @relation("ProjectCreator", fields: [ownerId], references: [id])
  members   ProjectMember[]

  requirements      Requirement[]
  testCases         TestCase[]
  testRuns          TestRun[]
  defects           Defect[]
  moduleDependencies ModuleDependency[]
  regressionPlans   RegressionPlan[]
  automationJobs    AutomationJob[]
  activityLogs      ActivityLog[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@index([archivedAt])
  @@map("projects")
}

enum ProjectRole {
  manager
  qa_lead
  tester
  viewer
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(tester)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Requirements
// ---------------------------------------------------------------------------

enum Priority {
  low
  medium
  high
  critical
}

enum RequirementStatus {
  draft
  under_review
  approved
  implemented
  verified
  deprecated
}

model Requirement {
  id                 String            @id @default(cuid())
  projectId          String
  ref                String
  title              String
  description        String
  module             String?
  acceptanceCriteria Json
  priority           Priority          @default(medium)
  status             RequirementStatus @default(draft)
  ownerId            String?
  createdById        String
  version            Int               @default(1)
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("RequirementCreator", fields: [createdById], references: [id])
  owner    User?                 @relation("RequirementOwner", fields: [ownerId], references: [id])
  versions RequirementVersion[]
  links    RequirementTestCase[]

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@index([projectId, module])
  @@index([projectId, archivedAt])
  @@map("requirements")
}

model RequirementVersion {
  id                 String   @id @default(cuid())
  requirementId      String
  version            Int
  title              String
  description        String
  module             String?
  acceptanceCriteria Json
  priority           Priority
  status             RequirementStatus
  changeNote         String?
  changedById        String
  createdAt          DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@unique([requirementId, version])
  @@index([requirementId, createdAt])
  @@map("requirement_versions")
}

// ---------------------------------------------------------------------------
// Test cases
// ---------------------------------------------------------------------------

enum TestCaseType {
  functional
  positive
  negative
  boundary
  integration
  regression
}

enum TestCaseStatus {
  draft
  under_review
  approved
  deprecated
}

model TestCase {
  id            String         @id @default(cuid())
  projectId     String
  ref           String
  title         String
  description   String?
  preconditions String?
  testData      String?
  type          TestCaseType   @default(functional)
  priority      Priority       @default(medium)
  status        TestCaseStatus @default(draft)
  isAutomated   Boolean        @default(false)
  source        String         @default("manual")
  aiGenerationId String?
  createdById   String
  version       Int            @default(1)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation(fields: [createdById], references: [id])
  steps       TestStep[]
  requirementLinks RequirementTestCase[]
  versions    TestCaseVersion[]
  results     TestResult[]
  aiGeneration AiGeneration?           @relation(fields: [aiGenerationId], references: [id])

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, isAutomated])
  @@index([projectId, archivedAt])
  @@map("test_cases")
}

model TestStep {
  id         String   @id @default(cuid())
  testCaseId String
  order      Int
  action     String
  expected   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, order])
  @@index([testCaseId])
  @@map("test_steps")
}

model TestCaseVersion {
  id          String       @id @default(cuid())
  testCaseId  String
  version     Int
  title       String
  description String?
  type        TestCaseType
  priority    Priority
  status      TestCaseStatus
  steps       Json
  changeNote  String?
  changedById String
  createdAt   DateTime     @default(now())

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@unique([testCaseId, version])
  @@map("test_case_versions")
}

model RequirementTestCase {
  id            String   @id @default(cuid())
  requirementId String
  testCaseId    String
  createdAt     DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([requirementId, testCaseId])
  @@index([testCaseId])
  @@map("requirement_test_cases")
}

// ---------------------------------------------------------------------------
// Test runs and results (results are append-only)
// ---------------------------------------------------------------------------

enum TestRunStatus {
  planned
  in_progress
  completed
  aborted
}

enum TestResult {
  pass
  fail
  blocked
  not_run
}

model TestRun {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  release     String?
  build       String?
  environment String
  scope       String        @default("selected")
  status      TestRunStatus @default(planned)
  startedAt   DateTime?
  completedAt DateTime?
  createdById String
  planId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id])
  plan      RegressionPlan? @relation(fields: [planId], references: [id])
  results   TestResult[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@index([projectId, release])
  @@map("test_runs")
}

model TestResult {
  id               String     @id @default(cuid())
  runId            String
  testCaseId       String
  attempt          Int        @default(1)
  result           TestResult @default(not_run)
  notes            String?
  durationMinutes  Int?
  environment      String?
  executedById     String?
  automated        Boolean    @default(false)
  automationJobId  String?
  executedAt       DateTime?
  createdAt        DateTime   @default(now())

  run      TestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase          @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executedBy User?            @relation(fields: [executedById], references: [id])
  defects   DefectTestResult[]

  @@unique([runId, testCaseId, attempt])
  @@index([testCaseId])
  @@index([runId, result])
  @@index([runId, executedAt])
  @@map("test_results")
}

// ---------------------------------------------------------------------------
// Defects
// ---------------------------------------------------------------------------

enum DefectStatus {
  open
  in_progress
  fixed
  ready_for_retest
  reopened
  closed
}

enum Severity {
  trivial
  low
  medium
  high
  critical
}

model Defect {
  id                String       @id @default(cuid())
  projectId         String
  ref               String
  title             String
  description       String
  reproductionSteps Json
  expectedBehavior  String?
  actualBehavior    String?
  severity          Severity     @default(medium)
  priority          Priority     @default(medium)
  status            DefectStatus @default(open)
  assigneeId        String?
  reporterId        String
  sourceResultId    String?
  retestRunId       String?
  archivedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?                 @relation("DefectAssignee", fields: [assigneeId], references: [id])
  reporter User                  @relation("DefectReporter", fields: [reporterId], references: [id])
  comments DefectComment[]
  history  DefectHistory[]
  links    DefectTestResult[]
  retestRun TestRun?            @relation("DefectRetestRun", fields: [retestRunId], references: [id])

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, createdAt])
  @@index([projectId, archivedAt])
  @@map("defects")
}

model DefectComment {
  id        String   @id @default(cuid())
  defectId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id])

  @@index([defectId, createdAt])
  @@map("defect_comments")
}

model DefectHistory {
  id         String       @id @default(cuid())
  defectId   String
  fromStatus DefectStatus?
  toStatus   DefectStatus
  note       String?
  changedById String
  createdAt  DateTime     @default(now())

  defect   Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([defectId, createdAt])
  @@map("defect_history")
}

model DefectTestResult {
  id        String @id @default(cuid())
  defectId  String
  resultId  String

  defect  Defect     @relation(fields: [defectId], references: [id], onDelete: Cascade)
  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([defectId, resultId])
  @@index([resultId])
  @@map("defect_test_results")
}

// ---------------------------------------------------------------------------
// Module dependencies, regression planning
// ---------------------------------------------------------------------------

model ModuleDependency {
  id             String   @id @default(cuid())
  projectId      String
  fromModule     String
  toModule       String
  dependencyType String   @default("service")
  description    String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromModule, toModule])
  @@index([projectId, fromModule])
  @@map("module_dependencies")
}

model RegressionPlan {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  baselineRunId   String?
  changeSetNote   String?
  changedRequirementIds Json
  recommendations Json
  selectedTestCaseIds    Json
  status          String   @default("draft")
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])
  runs    TestRun[]

  @@index([projectId, createdAt])
  @@map("regression_plans")
}

// ---------------------------------------------------------------------------
// AI generation
// ---------------------------------------------------------------------------

enum AiReviewStatus {
  pending
  approved
  rejected
}

model AiGeneration {
  id            String          @id @default(cuid())
  projectId     String?
  userId        String
  requirementId String?
  provider      String
  model         String
  inputSummary  String
  promptVersion String
  suggestions   Json
  approvedCount Int             @default(0)
  rejectedCount Int             @default(0)
  status        AiReviewStatus  @default(pending)
  durationMs    Int?
  createdAt     DateTime        @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  testCases   TestCase[]

  @@index([userId, createdAt])
  @@map("ai_generations")
}

// ---------------------------------------------------------------------------
// Automation (Playwright worker)
// ---------------------------------------------------------------------------

enum AutomationJobStatus {
  queued
  running
  passed
  failed
  cancelled
  timed_out
}

enum ArtifactType {
  screenshot
  log
  trace
  report
}

model AutomationJob {
  id          String              @id @default(cuid())
  projectId   String
  name        String
  suite       String
  framework   String              @default("playwright")
  targetUrl   String
  allowedHosts Json
  trigger     String              @default("manual")
  schedule    String?
  enabled     Boolean             @default(true)
  status      AutomationJobStatus @default(queued)
  timeoutMs   Int                 @default(120000)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                  @relation(fields: [createdById], references: [id])
  testCaseLinks AutomationJobTestCase[]
  runs      AutomationJobRun[]
  artifacts AutomationArtifact[]

  @@index([projectId, status])
  @@map("automation_jobs")
}

model AutomationJobTestCase {
  id         String @id @default(cuid())
  jobId      String
  testCaseId String

  job      AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  testCase TestCase     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([jobId, testCaseId])
  @@index([testCaseId])
  @@map("automation_job_test_cases")
}

model AutomationJobRun {
  id          String              @id @default(cuid())
  jobId       String
  status      AutomationJobStatus @default(queued)
  trigger     String              @default("manual")
  total       Int                 @default(0)
  passed      Int                 @default(0)
  failed      Int                 @default(0)
  skipped     Int                 @default(0)
  durationMs  Int?
  error       String?
  commitSha   String?
  branch      String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(now())

  job AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("automation_job_runs")
}

model AutomationArtifact {
  id         String       @id @default(cuid())
  jobId      String
  runId      String?
  type       ArtifactType
  fileName   String
  storageKey String
  contentType String
  sizeBytes  Int
  createdAt  DateTime     @default(now())

  job AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([runId])
  @@map("automation_artifacts")
}

// ---------------------------------------------------------------------------
// Activity logs and notifications
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}